{
  "manifest_version": 3,
  "name": "Cookit",
  "version": "0.4.2",
  "description": "Save recipes to your Cookit collection, open saved recipes and access your recipe book.",
  "key": "",
  "permissions": [
    "identity",
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://howto-liart.vercel.app/*",
    "https://kbnqajuwnhzwtnybqixn.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Cookit"
  }
}

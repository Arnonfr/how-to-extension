{
  "manifest_version": 3,
  "name": "HowTo Recipe Saver",
  "version": "0.1.0",
  "description": "Save recipes from any page or YouTube video to your HowTo cookbook.",
  "key": "",
  "permissions": ["identity", "storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://howto-liart.vercel.app/*",
    "https://kbnqajuwnhzwtnybqixn.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to HowTo"
  }
}
